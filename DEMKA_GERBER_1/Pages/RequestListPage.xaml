<Page x:Class="DEMKA_GERBER_1.Pages.RequestListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DEMKA_GERBER_1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RequestListPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

     
        <Rectangle Grid.Row="0" Fill="#BBDCFA" Height="50"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="C:\Users\user\Desktop\ПР\4 курс\DEMKA_2\Прил_В3_КОД 09.02.07-2-2025-БУ\Прил_В3_КОД 09.02.07-2-2025-БУ\Ресурсы\Новые технологии.png" 
               Height="30" Margin="0,0,10,0" Stretch="Uniform"/>
            <Label Content="Новые Технологии" FontSize="15" VerticalContentAlignment="Center"/>
        </StackPanel>
        <Label Content="Просмотр заявок партнеров" FontSize="25" VerticalContentAlignment="Center" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"  />
        <ListView x:Name="lv_Kartochki" Grid.Row="1" 
      ItemsSource="{Binding Request}" 
      Margin="0,60,0,0" 
      VerticalAlignment="Stretch"
      HorizontalContentAlignment="Stretch" Background="Transparent" MouseDoubleClick="lv_Kartochki_MouseDoubleClick">


            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1">

                        <StackPanel Orientation="Vertical">


                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                                HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Partner_Type}" 
                                   VerticalAlignment="Center" Margin="5,0"/>
                                    <Separator Width="12" Height="20" Background="Black" 
                                   Margin="5,0" RenderTransformOrigin="0.5,0.5"
                                   VerticalAlignment="Center">
                                        <Separator.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="-90"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Separator.RenderTransform>
                                    </Separator>
                                    <TextBlock Text="{Binding Partner_Name}" 
                                   VerticalAlignment="Center" Margin="5,0"/>
                                </StackPanel>


                                <TextBlock Grid.Column="1" Text="{Binding Cost,StringFormat='Цена с предоплатой: {0} руб'}" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                            </Grid>


                            <TextBlock Text="{Binding Adress,StringFormat='Адрес: {0}'}" Margin="5,2"/>
                            <TextBlock Text="{Binding Telephone,StringFormat='Телефон: {0}'}" Margin="5,2"/>
                            <TextBlock Text="{Binding Rating,StringFormat='Рейтинг: {0}'}" Margin="5,2"/>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="btn_sozdat_zayavku" Content="Создать Заявку" 
    Grid.Row="1" 
    HorizontalAlignment="Right" 
    VerticalAlignment="Top" 
    Margin="0,5,61,0" 
    Panel.ZIndex="1" Click="btn_sozdat_zayavku_Click"/>
    </Grid>
</Page>
