<Page x:Class="DEMKA_GERBER_1.Pages.RedactDeletePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Редактирование / Удаление заявки">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Rectangle Grid.Row="0" Fill="#BBDCFA"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="C:\Users\user\Desktop\ПР\4 курс\DEMKA_2\Прил_В3_КОД 09.02.07-2-2025-БУ\Прил_В3_КОД 09.02.07-2-2025-БУ\Ресурсы\Новые технологии.png" 
                   Height="30" Margin="0,0,10,0" Stretch="Uniform"/>
            <Label Content="Новые Технологии" FontSize="15" VerticalContentAlignment="Center"/>
        </StackPanel>
        <Button x:Name="btn_Nazad" Grid.Row="0" Content="← Назад" 
                HorizontalAlignment="Right" Margin="0,0,15,0" Width="80" Height="30" 
                Click="btn_Nazad_Click" />

        <!-- Форма (одна колонка, по центру) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,10,20,20" Width="400" HorizontalAlignment="Center">
                <Label x:Name="lb_name" Content="Редактирование заявки" 
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Тип партнера -->
                <Label Content="Тип партнера:" FontSize="16" Margin="0,5,0,0"/>
                <ComboBox x:Name="type_box" Height="30" Margin="0,0,0,5"/>

                <!-- Наименование -->
                <Label Content="Наименование:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Name" Height="30" Margin="0,0,0,5"/>

                <!-- ФИО директора -->
                <Label Content="ФИО директора:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Director" Height="30" Margin="0,0,0,5"/>

                <!-- Адрес (улица, дом) -->
                <Label Content="Адрес (улица, дом):" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Address" Height="30" Margin="0,0,0,5" 
         ToolTip="Введите улицу и номер дома"/>

                <!-- НОВЫЕ ПОЛЯ: Область и Город -->
                <Label Content="Область:" FontSize="16" Margin="0,5,0,0"/>
                <ComboBox x:Name="cmb_Oblast" Height="30" Margin="0,0,0,5"
          DisplayMemberPath="Oblast_Name" SelectedValuePath="Oblast_ID"/>

                <Label Content="Город:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_City" Height="30" Margin="0,0,0,5"/>

                <!-- Рейтинг -->
                <Label Content="Рейтинг:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Rating" Height="30" Margin="0,0,0,5" 
         ToolTip="Числовое значение, например, 4.5"/>

                <!-- Телефон -->
                <Label Content="Телефон:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Phone" Height="30" Margin="0,0,0,5" 
         ToolTip="В формате +7(123)456-78-90"/>

               
                <Label Content="Количество:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Ammount" Height="30" Margin="0,0,0,5" 
                         ToolTip="Введите количество" TextChanged="txt_Ammount_TextChanged"/>

                <Label Content="Цена за ед.:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_PricePerUnit" Height="30" Margin="0,0,0,5" 
                         ToolTip="Введите цену за единицу" TextChanged="txt_PricePerUnit_TextChanged"/>

                <Label Content="Предоплата:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Prepayment" Height="30" Margin="0,0,0,5" 
                         ToolTip="Введите сумму предоплаты" TextChanged="txt_Prepayment_TextChanged"/>

                <Label Content="Итоговая цена:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_TotalPrice" Height="30" Margin="0,0,0,5" 
                         IsReadOnly="True" Background="#F0F0F0"
                         ToolTip="Вычисляется автоматически"/>

               
                <Label Content="Email:" FontSize="16" Margin="0,5,0,0"/>
                <TextBox x:Name="txt_Email" Height="30" Margin="0,0,0,5" 
                         ToolTip="example@mail.ru"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
                    <Button x:Name="btn_Save" Content="💾 Сохранить" Width="120" Height="35" 
                            Margin="0,0,20,0" Background="#4CAF50" Foreground="White" Click="btn_Save_Click"/>
                    <Button x:Name="btn_Delete" Content="🗑️ Удалить" Width="120" Height="35" 
                            Margin="0,0,20,0" Background="#F44336" Foreground="White" Click="btn_Delete_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>